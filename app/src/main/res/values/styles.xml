<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="lumo_bg">#FF07090C</color>
    <color name="lumo_surface">#FF12161C</color>

    <!-- Tema do app: sempre escuro, ciano do logo como destaque e diálogos no estilo do Lumo. -->
    <style name="LumoApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF22DFF3</item>
        <item name="android:colorPrimary">#FF07090C</item>
        <item name="android:colorPrimaryDark">#FF07090C</item>
        <item name="android:colorBackground">@color/lumo_bg</item>
        <item name="android:windowBackground">@color/lumo_bg</item>
        <item name="android:alertDialogTheme">@style/LumoDialog</item>
    </style>

    <!-- Confirmações e formulários (AlertDialog): cartão arredondado, botões sem caixa alta. -->
    <style name="LumoDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lumo_dialog_bg</item>
        <item name="android:colorAccent">#FF22DFF3</item>
        <item name="android:colorBackground">@color/lumo_surface</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:buttonBarButtonStyle">@style/LumoDialogButton</item>
        <item name="android:windowTitleStyle">@style/LumoDialogTitle</item>
    </style>

    <style name="LumoDialogTitle" parent="android:TextAppearance.Material.Title">
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="LumoDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FF22DFF3</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
